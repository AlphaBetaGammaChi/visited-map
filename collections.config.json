{
  "collections": [
    {
      "id": "rspb",
      "title": "RSPB Reserves",
      "singular": "reserve",
      "color": "#0057b8",
      "glyph": "🐦",
      "scope": "uk",
      "description": "Royal Society for the Protection of Birds nature reserves",
      "source": {
        "type": "overpass",
        "area": "gb",
        "query": "(nwr[\"operator\"~\"RSPB|Royal Society for the Protection\",i](area.gb);nwr[\"name\"~\"RSPB\",i](area.gb);)"
      },
      "require_name_match": "\\bRSPB\\b|Royal Society",
      "exclude_name": "shop|office|centre|center|café|cafe|car ?park|depot|garage|warehouse|pumping|toilet|headquarters|hide\\b|hides\\b|trail\\b|path\\b|entrance|gateway|platform|viewing|boardwalk|screen\\b|shelter|picnic|loop\\b|bimble|circular|scout|barn\\b|fields\\b|cottage|workshop|garden|memorial|bench",
      "require": {
        "any_tags": ["leisure", "boundary", "natural", "landuse", "water", "wetland", "tourism", "geological"],
        "if_tags": ["shop", "office", "amenity"]
      },
      "dedupe_strip": "\\b(rspb|nature reserve|reserve|nnr|national)\\b"
    },
    {
      "id": "national-trust",
      "title": "National Trust",
      "singular": "property",
      "color": "#4d7c0f",
      "glyph": "🌳",
      "scope": "uk",
      "description": "National Trust (and NT for Scotland) places",
      "source": {
        "type": "overpass",
        "area": "gb",
        "query": "nwr[\"operator\"~\"National Trust\",i](area.gb);"
      },
      "exclude_name": "national trust$|^national trust$|\\bwalk\\b|\\bwalks\\b|trail|circular|stroll|ramble|hike|saunter|waymarked|cottage|bothy|bunkhouse|campsite|camp ?site|caravan|holiday let|car ?park|parking|toilet|picnic|kiosk|notice|information board|interpretation|signpost|waymark|bench|seat\\b|memorial bench|visitor centre|visitor center|reception|ticket office|second ?hand book|bookshop|gift shop|plant sale|café|cafe|tea ?room|restaurant|pub\\b|office|workshop|sawmill|yard\\b|depot|store\\b|stores\\b|garage|pump(ing)? station|sluice|weir|pump\\b|boathouse|landing|ferry|jetty|slipway|mooring|^track\\b|\\bgate\\b|entrance|access point|stile|bridge\\b|ford\\b|bird hide|wildlife hide|\\bhide\\b|viewpoint marker|orienteering|geocache|^\\(.*\\)|^\\d{3,4}\\b|^mtb\\b|bike trail|play ?area|playground|den building|dog bin|litter bin|recycling|water tap|shower|laundry|wi-?fi|\\bshop\\b|\\bshed\\b",
      "exclude_tags": {
        "route": ".*",
        "tourism": "information|artwork"
      },
      "exclude_tags_soft": {
        "amenity": "parking|toilets|cafe|restaurant|fast_food|drinking_water|bicycle_rental|bench|waste_basket"
      },
      "exclude_soft_unless": ["wikidata"],
      "drop_tags": {"tags": ["shop", "office", "man_made"], "unless": ["wikidata", "historic"]},
      "require": {
        "any_tags": ["wikidata", "historic", "boundary", "leisure", "natural", "landuse", "ruins", "archaeological_site", "place", "military"],
        "tag_in": {"tourism": ["attraction", "museum", "gallery", "viewpoint", "theme_park", "zoo", "picnic_site", "camp_site"]},
        "building_needs": ["historic", "tourism", "wikidata"]
      }
    },
    {
